{
"family": "my-node-app-task",
"networkMode": "awsvpc",
"requiresCompatibilities": ["FARGATE"],
"cpu": "256",
"memory": "512",
"executionRoleArn": "arn:aws:iam::716084142883:role/ecsTaskExecutionRole",
"containerDefinitions": [
	{
		"name": "my-node-app",
		"image": "716084142883.dkr.ecr.eu-north-1.amazonaws.com/my-node-app:latest",
"portMappings": [
	{
		"containerPort": 3000,
		"protocol": "tcp"
	}
   ]
	}
   ]
}
