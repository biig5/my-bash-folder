{
  "family": "my-python-app-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::716084142883:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "my-python-app",
      "image": "716084142883.dkr.ecr.eu-north-1.amazonaws.com/my-python-app:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ]
}
